{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Check HTML and simulated diagnostics",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/08_Software/mlx90614-webhid/tools/Check-Html.ps1",
        "-Diagnostics"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Serve MLX90614 app on localhost:8000",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "127.0.0.1",
        "--directory",
        "${workspaceFolder}/08_Software/mlx90614-webhid"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Open Qwiic thermocouple dashboard",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/08_Software/qwiic-thermocouple/Start-Monitor.ps1", "-Connect"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ]
}
